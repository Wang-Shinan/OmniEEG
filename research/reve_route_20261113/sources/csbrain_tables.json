        "",
        "R 2 = 1 − ∑ i = 1 N ( y i − y ^ i ) 2 ∑ i = 1 N ( y i − y ¯ ) 2 . R^{2}=1-\\frac{\\sum_{i=1}^{N}(y_{i}-\\hat{y}_{i})^{2}}{\\sum_{i=1}^{N}(y_{i}-\\bar{y})^{2}}.",
        "",
        "(16)"
      ]
    ]
