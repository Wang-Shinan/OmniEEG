        "AUC-PR = ∫ 0 1 Precision ​ ( r ) ​ 𝑑 r , r = Recall . \\text{AUC-PR}=\\int_{0}^{1}\\text{Precision}(r)\\,dr,\\quad r=\\text{Recall}.",
        "",
        "(12)"
      ]
    ]
  },
  {
    "index": 16,
    "id": "A3.E13",
    "caption": "",
    "rows": [
      [
        "",
        "TPR = T ​ P T ​ P + F ​ N , FPR = F ​ P F ​ P + T ​ N . \\text{TPR}=\\frac{TP}{TP+FN},\\quad\\text{FPR}=\\frac{FP}{FP+TN}.",
        "",
        "(13)"
      ]
    ]
  },
  {
    "index": 17,
    "id": "A3.E14",
    "caption": "",
    "rows": [
      [
        "",
        "AUROC = ∫ 0 1 TPR ​ ( f ) ​ 𝑑 f , f = FPR . \\text{AUROC}=\\int_{0}^{1}\\text{TPR}(f)\\,df,\\quad f=\\text{FPR}.",
        "",
        "(14)"
      ]
    ]
  },
  {
    "index": 18,
    "id": "A3.E15",
    "caption": "",
    "rows": [
      [
        "",
        "r = ∑ i = 1 N ( y i − y ¯ ) ​ ( y ^ i − y ^ ¯ ) ∑ i = 1 N ( y i − y ¯ ) 2 ⋅ ∑ i = 1 N ( y ^ i − y ^ ¯ ) 2 , r=\\frac{\\sum_{i=1}^{N}(y_{i}-\\bar{y})(\\hat{y}_{i}-\\bar{\\hat{y}})}{\\sqrt{\\sum_{i=1}^{N}(y_{i}-\\bar{y})^{2}}\\cdot\\sqrt{\\sum_{i=1}^{N}(\\hat{y}_{i}-\\bar{\\hat{y}})^{2}}},",
        "",
        "(15)"
      ]
    ]
  },
  {
